<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="ro.tinulica.tvhome"
    android:versionCode="3"
    android:versionName="3.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="28" />

    <!-- Wi-Fi name in the Control Center (Android only reveals it with location access). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Joining Wi-Fi networks and pairing Bluetooth devices from the Control Center and Settings. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Top shelf: the Watch Next / preview channels apps publish for the home screen, and their posters. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Closing apps from the app switcher (ends background apps only). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Without this the TV provider only returns our own rows; tvtool grants it over ADB. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Which apps you use most, for ordering the top shelf; granted by tvtool with appops. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Only when granted with `tvtool surse`: switches our accessibility service back on after
         TCL's auto-start blocker turns it off (after updates and restarts). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Needed on Android 11+ to see which apps are installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="TV Home"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Home"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection|fontScale|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:taskAffinity="ro.tinulica.tvhome.settings"
            android:excludeFromRecents="true"
            android:theme="@style/Home"
            android:screenOrientation="landscape" />
        <activity
            android:name=".GlassBench"
            android:exported="true"
            android:theme="@style/Home"
            android:taskAffinity="ro.tinulica.tvhome.bench"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ChannelActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="ro.tinulica.tvhome.channels"
            android:theme="@style/Home"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity
            android:name=".SourceActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="ro.tinulica.tvhome.source"
            android:theme="@style/Home"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <activity
            android:name=".CinemaActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="ro.tinulica.tvhome.cinema"
            android:excludeFromRecents="true"
            android:theme="@style/Home"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <service
            android:name=".NoticeListener"
            android:label="TV Home Notificări"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".SourcesService"
            android:label="@string/sources_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/sources_service" />
        </service>
        <receiver
            android:name=".MessageReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
